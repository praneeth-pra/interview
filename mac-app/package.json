{
  "name": "hi-techie-mac",
  "productName": "Hi-Techie",
  "version": "1.1.0",
  "private": true,
  "description": "Hi-Techie desktop app for macOS: opens hi-techie.dev in its own window",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node tests/links.test.cjs",
    "dist": "electron-builder --mac --arm64",
    "dist:dir": "electron-builder --mac --dir"
  },
  "devDependencies": {
    "electron": "44.7.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "dev.hi-techie.desktop",
    "productName": "Hi-Techie",
    "files": [
      "main.js",
      "links.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "Hi-Techie"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en"
    ]
  }
}
