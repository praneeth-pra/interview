{
  "name": "booking-form",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/server.ts",
    "test": "bun test tests/",
    "typecheck": "tsc -p src/pages/tsconfig.json && tsc -p tsconfig.server.json",
    "format": "prettier --write \"src/**/*.{ts,js,css}\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,css}\" \"scripts/**/*.ts\"",
    "test:coverage": "bun test --coverage tests/"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  }
}
